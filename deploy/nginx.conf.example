server {
    listen 443 ssl;
    server_name chat-screenshots.sakuradon.com;
    ssl_certificate /etc/letsencrypt/live/sakuradon.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sakuradon.com/privkey.pem;

    include snippets/authelia-location.conf;

    location / {
        include snippets/authelia-authrequest.conf;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 32m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://192.168.1.202:8100;
    }
}
